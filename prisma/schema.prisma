generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ContactSubmission {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  name      String
  email     String
  company   String?
  message   String

  @@map("contact_submissions")
}
