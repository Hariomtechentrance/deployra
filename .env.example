# Password for /admin -- pick your own, don't use this placeholder
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin session cookie (32+ bytes).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# On Render, leave this to the render.yaml blueprint (generateValue: true)
# instead of setting it by hand.
SESSION_SECRET=

# Postgres connection string (Supabase, Neon, RDS, etc). Use a
# session-mode / non-pooled connection -- this app runs as a persistent
# Node server, not serverless functions, so no pgbouncer transaction
# pooling is needed.
DATABASE_URL=

# Optional: your real production domain, used to build absolute URLs in
# robots.txt / sitemap.xml. Leave unset until you have one.
NEXT_PUBLIC_SITE_URL=
